{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/docs-guard.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/check-docs.mjs --stop" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "git config core.hooksPath .githooks" }]
      }
    ]
  }
}
