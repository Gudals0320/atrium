{
  "version": 2,
  "name": "rules-grow",
  "docs": {
    "rules": {
      "path": "docs/rules.txt",
      "role": "canon",
      "load": "always",
      "stale": "30d"
    },
    "facts": {
      "path": "docs/facts.txt",
      "role": "canon",
      "stale": {
        "after_change_of": "rules"
      }
    },
    "corrections": {
      "path": "ledger/corrections.jsonl",
      "role": "ledger",
      "git": false,
      "owner": "retro"
    }
  },
  "seats": {
    "keeper": {
      "launcher": "claude",
      "session": "keep",
      "reads": [
        "facts"
      ],
      "writes": [
        "corrections"
      ]
    }
  },
  "hooks": [
    {
      "at": "done",
      "run": [
        "node",
        ".atrium/hooks/record.mjs"
      ],
      "records": "corrections"
    }
  ],
  "cycles": [
    {
      "every": "7d",
      "to": "keeper"
    }
  ],
  "manager": "keeper"
}
